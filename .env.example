# Supabase — the COURT MANAGER (engine) project.
# These three are compiled into the browser bundle by Vite (anything
# prefixed VITE_ is public by definition), so none of them is a secret and
# none of them is what protects the data. Row Level Security is. Treat this
# file as documentation of which vars the app needs, not as a vault.
#
# The clubhouse uses a different project and hard-codes its publishable key
# in src/clubhouse/supabaseClient.ts.
#
# Never put a service-role key in any VITE_ variable. It would ship to every
# visitor and bypass RLS entirely.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
