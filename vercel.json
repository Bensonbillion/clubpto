{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(robots.txt|og-image.jpg|favicon.ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/about",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/faq",
      "destination": "/play",
      "permanent": false
    },
    {
      "source": "/book",
      "destination": "/play",
      "permanent": false
    },
    {
      "source": "/community",
      "destination": "/events",
      "permanent": false
    },
    {
      "source": "/league/join",
      "destination": "/league#season-2",
      "permanent": false
    },
    {
      "source": "/install",
      "destination": "/play",
      "permanent": false
    },
    {
      "source": "/club",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/club/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/membership",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
