{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ikfbtktofcfkpqxwlfku.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "club-pto-mcp",
      "version": "0.1.0",
      "title": "Club PTO"
    },
    "tools": [
      {
        "name": "list_upcoming_sessions",
        "title": "List upcoming sessions",
        "description": "List active upcoming Club PTO padel sessions with date, time, price, and spots remaining.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Max sessions to return (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_players",
        "title": "List players",
        "description": "List players in the Club PTO roster with name, tier, VIP flag, and cumulative stats.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "tier": {
              "description": "Filter by tier.",
              "type": "string",
              "enum": [
                "A",
                "B",
                "C"
              ]
            },
            "limit": {
              "description": "Max players (default 50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_leaderboard",
        "title": "Get leaderboard",
        "description": "Get the top Club PTO players ranked by total points across all sessions.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Top N (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
